@@ -406,12 +406,15 @@ library_for_all_configs("libdart") {
   ]
 }
 
-shared_library("dart_jit_library") {
-  output_name = "dart_jit"
-  ldflags = [ "-Wl,-install_name,@rpath/Dart.framework/Dart" ]
-  public = [ "include/dart_api.h" ]
-  deps = [ ":libdart_jit" ]
-  public_configs = [ ":dart_public_config" ]
+# CTR packages static runtimes; dynamic libraries require an OS loader.
+if (!is_ctr) {
+  shared_library("dart_jit_library") {
+    output_name = "dart_jit"
+    ldflags = [ "-Wl,-install_name,@rpath/Dart.framework/Dart" ]
+    public = [ "include/dart_api.h" ]
+    deps = [ ":libdart_jit" ]
+    public_configs = [ ":dart_public_config" ]
+  }
 }
 

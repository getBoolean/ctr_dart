diff --git a/runtime/platform/utils.cc b/runtime/platform/utils.cc
index c44ef0f5..fe5f0dff 100644
--- a/runtime/platform/utils.cc
+++ b/runtime/platform/utils.cc
@@ -11,8 +11,6 @@
     defined(DART_HOST_OS_ANDROID)
 #include <dlfcn.h>
 #include <libgen.h>
-#elif defined(DART_HOST_OS_CTR)
-#include <libgen.h>
 #elif defined(DART_HOST_OS_FUCHSIA)
 #include <dlfcn.h>
 #include <fuchsia/io/cpp/fidl.h>
@@ -439,6 +437,15 @@ char* Utils::Basename(const char* path) {
 #if defined(DART_HOST_OS_FUCHSIA) || defined(DART_HOST_OS_WINDOWS)
   // Not handled for these operating systems.
   return nullptr;
+#elif defined(DART_HOST_OS_CTR)
+  if (path == nullptr) return nullptr;
+  intptr_t end = strlen(path);
+  if (end == 0) return Utils::StrDup(".");
+  while (end > 1 && path[end - 1] == '/') --end;
+  intptr_t start = end;
+  while (start > 0 && path[start - 1] != '/') --start;
+  if (start == end) return Utils::StrDup("/");
+  return Utils::StrNDup(path + start, end - start);
 #else
   if (path == nullptr) return nullptr;
   char* const path_copy = Utils::StrDup(path);

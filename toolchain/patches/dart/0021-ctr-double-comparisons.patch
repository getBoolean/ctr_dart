+static Condition EmitCtrDoubleComparison(FlowGraphCompiler* compiler,
+                                         const LocationSummary& locs,
+                                         Token::Kind kind,
+                                         BranchLabels labels) {
+  const Register left_lo = locs.temp(0).reg();
+  const Register left_hi = locs.temp(1).reg();
+  const Register right_lo = locs.temp(2).reg();
+  const Register right_hi = locs.temp(3).reg();
+  __ vmovrrd(left_lo, left_hi, EvenDRegisterOf(locs.in(0).fpu_reg()));
+  __ vmovrrd(right_lo, right_hi, EvenDRegisterOf(locs.in(1).fpu_reg()));
+
+  auto* less = (kind == Token::kLT || kind == Token::kLTE || kind == Token::kNE)
+                   ? labels.true_label : labels.false_label;
+  auto* equal = (kind == Token::kEQ || kind == Token::kLTE || kind == Token::kGTE)
+                    ? labels.true_label : labels.false_label;
+  auto* greater = (kind == Token::kGT || kind == Token::kGTE || kind == Token::kNE)
+                      ? labels.true_label : labels.false_label;
+  auto* unordered = kind == Token::kNE ? labels.true_label : labels.false_label;
+  compiler::Label left_ordered, both_ordered, same_sign, unsigned_lower;
+
+  // Shift out the sign; values beyond infinity, including low payloads, are NaN.
+  __ LoadImmediate(TMP, 0xffe00000);
+  __ cmp(TMP, compiler::Operand(left_hi, LSL, 1));
+  __ b(&left_ordered, HI);
+  __ b(unordered, CC);
+  __ cmp(left_lo, compiler::Operand(0));
+  __ b(unordered, NE);
+  __ Bind(&left_ordered);
+  __ cmp(TMP, compiler::Operand(right_hi, LSL, 1));
+  __ b(&both_ordered, HI);
+  __ b(unordered, CC);
+  __ cmp(right_lo, compiler::Operand(0));
+  __ b(unordered, NE);
+  __ Bind(&both_ordered);
+
+  // IEEE equality identifies the two encodings of zero.
+  __ orr(TMP, left_lo, compiler::Operand(right_lo));
+  __ orr(TMP, TMP, compiler::Operand(left_hi, LSL, 1));
+  __ orr(TMP, TMP, compiler::Operand(right_hi, LSL, 1));
+  __ cmp(TMP, compiler::Operand(0));
+  __ b(equal, EQ);
+
+  __ eor(TMP, left_hi, compiler::Operand(right_hi));
+  __ TestImmediate(TMP, 0x80000000);
+  __ b(&same_sign, EQ);
+  __ TestImmediate(left_hi, 0x80000000);
+  __ b(less, NE);
+  __ b(greater);
+  __ Bind(&same_sign);
+  __ cmp(left_hi, compiler::Operand(right_hi));
+  __ cmp(left_lo, compiler::Operand(right_lo), EQ);
+  __ b(equal, EQ);
+  __ b(&unsigned_lower, CC);
+  __ TestImmediate(left_hi, 0x80000000);
+  __ b(less, NE);
+  __ b(greater);
+  __ Bind(&unsigned_lower);
+  __ TestImmediate(left_hi, 0x80000000);
+  __ b(greater, NE);
+  __ b(less);
+  return EQ;  // Every path above branches to a supplied result label.
+}

+// Preserve every allocatable volatile register: box/unbox can also allocate on
+// a separate slow path. Keep the result in reserved DTMP across restoration.
+static void EmitCtrFloatConversion(FlowGraphCompiler* compiler,
+                                   DRegister value,
+                                   DRegister result,
+                                   bool narrow) {
+  {
+    compiler::LeafRuntimeScope rt(compiler->assembler(), /*frame_size=*/8,
+                                 /*preserve_registers=*/true);
+    __ StoreDToOffset(value, SP, 0);
+    __ mov(R0, compiler::Operand(SP));
+    __ LoadImmediate(R1, narrow ? 1 : 0);
+    rt.Call(kCtrFloatConvertRuntimeEntry, /*argument_count=*/2);
+    __ LoadDFromOffset(DTMP, SP, 0);
+  }
+  if (narrow) {
+    __ vmovs(EvenSRegisterOf(result), STMP);
+  } else {
+    __ vmovd(result, DTMP);
+  }
+}
